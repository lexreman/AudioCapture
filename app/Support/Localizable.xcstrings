    "Records the sound your Mac plays,\nfrom every app or just one.\nYour voice only if you add it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt den Ton deines Mac auf,\nvon allen Apps oder nur von einer.\nDeine Stimme nur,\nwenn du sie hinzufügst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba el sonido de tu Mac,\nde todas las apps o de una sola.\nTu voz solo si la añades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre le son de votre Mac,\nde toutes les apps ou d’une seule.\nVotre voix seulement si vous l’ajoutez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra il suono riprodotto dal Mac,\nda tutte le app o da una sola.\nLa tua voce solo se la aggiungi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで再生される音を録音します。\nすべてのAppでも、1つのAppだけでも。\n自分の声は、追加した場合のみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 재생되는 소리를 녹음합니다.\n모든 앱 또는 하나의 앱에서.\n내 목소리는 추가한 경우에만 녹음됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava o som que o Mac reproduz,\nde todos os apps ou de apenas um.\nSua voz só é gravada\nse você adicioná‑la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制Mac播放的声音，\n可录制所有App，或仅一个App。\n只有在你添加后，才会录制你的声音。"
          }
        }
      }
    },
