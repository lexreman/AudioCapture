    "Your voice is cut. Click to record it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme ist stummgeschaltet. Klicke, um sie wieder aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz está silenciada. Haz clic para volver a grabarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre voix est coupée. Cliquez pour la réactiver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua voce è esclusa. Fai clic per registrarla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の声はミュート中です。クリックするとミュートを解除します。"
