    "Your voice joins when %@ uses the mic.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme kommt hinzu, wenn %@ das Mikrofon verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz se añade cuando %@ usa el micrófono."
